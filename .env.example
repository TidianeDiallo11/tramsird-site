DATABASE_URL="postgresql://user:password@host:5432/shopflow?schema=public"

# Auth
AUTH_SECRET="GENERATE_A_LONG_RANDOM_SECRET"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ShopFlow"
NEXT_PUBLIC_CURRENCY="GNF"

# --- Mobile Money / Payment providers -------------------------------------
# These are intentionally left empty in development. PaymentService will
# refuse to process a real charge until real credentials are supplied here.
# NEVER expose these to the frontend (no NEXT_PUBLIC_ prefix).
ORANGE_MONEY_API_BASE_URL=""
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_MERCHANT_KEY=""
ORANGE_MONEY_WEBHOOK_SECRET=""

MTN_MOMO_API_BASE_URL=""
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_TARGET_ENVIRONMENT="sandbox"
MTN_MOMO_WEBHOOK_SECRET=""

CARD_PSP_API_KEY=""
CARD_PSP_WEBHOOK_SECRET=""

# --- Password reset (SMS + email) ------------------------------------------
# Used to send the customer's SMS reset code and the staff's email reset
# link. Left empty in development: the message is logged to the server
# console instead of actually being sent.
SMS_API_BASE_URL=""
SMS_API_KEY=""
SMS_SENDER_ID=""

EMAIL_API_KEY=""
EMAIL_FROM=""
